                },
                "ask": {
                  "type": "integer",
                  "minimum": 0
                },
                "warn": {
                  "type": "integer",
                  "minimum": 0
                },
                "info": {
                  "type": "integer",
                  "minimum": 0
                },
                "other": {
                  "type": "integer",
                  "minimum": 0
                },
                "untiered": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        }
      }
    },
    "week": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "week",
        "sessions",
