            "mutating_bash_calls": {
              "type": "integer",
              "minimum": 0
            },
            "scratch_bash_calls": {
              "type": "integer",
              "minimum": 0
            },
            "questions_asked": {
              "type": "integer",
              "minimum": 0
            },
            "interrupts": {
              "type": "integer",
              "minimum": 0
            },
            "compactions": {
              "type": "integer",
              "minimum": 0
            },
            "subagent_launches": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "permissions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "auto_allowed",
            "user_allowed_once",
            "user_allowed_rule",
            "auto_denied",
            "hook_denied",
            "user_rejected",
            "other"
          ],
          "properties": {
            "auto_allowed": {
              "type": "integer",
              "minimum": 0
            },
            "user_allowed_once": {
              "type": "integer",
              "minimum": 0
            },
            "user_allowed_rule": {
              "type": "integer",
              "minimum": 0
            },
            "auto_denied": {
              "type": "integer",
              "minimum": 0
            },
            "hook_denied": {
              "type": "integer",
              "minimum": 0
            },
            "user_rejected": {
              "type": "integer",
              "minimum": 0
            },
