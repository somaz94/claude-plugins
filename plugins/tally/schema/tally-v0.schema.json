{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/somaz94/claude-plugins/blob/main/plugins/tally/schema/tally-v0.schema.json",
  "title": "tally/v0",
  "description": "Counts-only summary of one Claude Code harness, produced by plugins/tally/scripts/tally.py. Every key is fixed here and additionalProperties is false at every level, so no free-form text (paths, commands, project, agent or hook names) can appear. v0: may change before any data is collected under it.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "tool_version",
    "classifier",
    "generated",
    "window",
    "input",
    "harness",
    "totals",
    "weeks"
  ],
  "properties": {
    "schema": {
      "const": "tally/v0"
    },
    "tool_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "classifier": {
      "const": "mutating-v0"
    },
    "generated": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "first",
        "last",
        "weeks"
      ],
      "properties": {
        "first": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "last": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "weeks": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "files_read",
        "lines_read",
        "unrecognized_lines"
      ],
      "properties": {
        "files_read": {
          "type": "integer",
          "minimum": 0
        },
        "lines_read": {
          "type": "integer",
          "minimum": 0
        },
        "unrecognized_lines": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "harness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "config_dirs",
        "agents",
        "commands",
        "skills",
        "hooks"
      ],
      "properties": {
        "config_dirs": {
          "type": "integer",
          "minimum": 0
        },
        "agents": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "total",
            "write_capable",
            "inherit_all_tools"
          ],
          "properties": {
            "total": {
              "type": "integer",
              "minimum": 0
            },
            "write_capable": {
              "type": "integer",
              "minimum": 0
            },
            "inherit_all_tools": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "commands": {
          "type": "integer",
          "minimum": 0
        },
        "skills": {
          "type": "integer",
          "minimum": 0
        },
        "hooks": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "total",
            "by_event"
          ],
          "properties": {
            "total": {
              "type": "integer",
              "minimum": 0
            },
            "by_event": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "PreToolUse",
                "PostToolUse",
                "UserPromptSubmit",
                "SessionStart",
                "SessionEnd",
                "Stop",
                "SubagentStop",
                "PreCompact",
                "Notification",
                "other"
              ],
              "properties": {
                "PreToolUse": {
                  "type": "integer",
                  "minimum": 0
                },
                "PostToolUse": {
                  "type": "integer",
                  "minimum": 0
                },
                "UserPromptSubmit": {
                  "type": "integer",
                  "minimum": 0
                },
                "SessionStart": {
                  "type": "integer",
                  "minimum": 0
                },
                "SessionEnd": {
                  "type": "integer",
                  "minimum": 0
                },
                "Stop": {
                  "type": "integer",
                  "minimum": 0
                },
                "SubagentStop": {
                  "type": "integer",
                  "minimum": 0
                },
                "PreCompact": {
                  "type": "integer",
                  "minimum": 0
                },
                "Notification": {
                  "type": "integer",
                  "minimum": 0
                },
                "other": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        }
      }
    },
    "totals": {
      "$ref": "#/$defs/bucket"
    },
    "weeks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/week"
      }
    }
  },
  "$defs": {
    "bucket": {
      "type": "object",
      "additionalProperties": false,
      "required": [
