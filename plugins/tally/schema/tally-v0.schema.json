          "properties": {
            "auto_allowed": {
              "type": "integer",
              "minimum": 0
            },
            "user_allowed_once": {
              "type": "integer",
              "minimum": 0
            },
            "user_allowed_rule": {
              "type": "integer",
              "minimum": 0
            },
            "auto_denied": {
