            "system_message"
          ],
          "properties": {
            "additional_context": {
              "type": "integer",
              "minimum": 0
            },
            "blocking_error": {
              "type": "integer",
              "minimum": 0
            },
            "non_blocking_error": {
              "type": "integer",
